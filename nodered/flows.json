    {
        "id": "fn_parse_status",
        "type": "function",
        "z": "tab_petfeeder_arch",
        "name": "Chuẩn hóa trạng thái thiết bị",
        "func": "let d = msg.payload;\ntry {\n    if (Buffer.isBuffer(d)) d = d.toString(\"utf8\");\n    if (typeof d === \"string\") d = JSON.parse(d);\n    if (!d || typeof d !== \"object\") return null;\n\n    const status = String(d.status || \"\").toLowerCase();\n    const detail = String(d.detail || \"\");\n\n    let deviceText = \"\";\n    let teleAck = null;\n\n    switch (status) {\n        case \"online\":\n            deviceText = \"ONLINE - ESP32 kết nối MQTT\";\n            break;\n        case \"offline\":\n            deviceText = \"OFFLINE - ESP32 mất kết nối MQTT\";\n            break;\n        case \"feeding_started\":\n            deviceText = \"ONLINE - Đang xả hạt (ACK: Đã nhận lệnh)\";\n            teleAck = {\n                payload: {\n                    chat_id: \"8518694966\",\n                    text: \"🔔 [FEEDBACK ACK] ESP32 xác nhận: Bắt đầu kích hoạt servo xả hạt thành công!\"\n                }\n            };\n            break;\n        case \"rejected\":\n            deviceText = \"ONLINE - Từ chối xả hạt: \" + detail;\n            teleAck = {\n                payload: {\n                    chat_id: \"8518694966\",\n                    text: `⚠️ [FEEDBACK NACK] ESP32 từ chối xả hạt! Lý do: ${detail}`\n                }\n            };\n            break;\n        case \"duplicate_ignored\":\n            deviceText = \"ONLINE - Bỏ qua lệnh trùng\";\n            break;\n        case \"low_food\":\n            deviceText = \"ONLINE - Cảnh báo thức ăn thấp\";\n            break;\n        default:\n            deviceText = status ? \"Trạng thái: \" + status : \"Chưa có trạng thái\";\n    }\n\n    const low = status === \"low_food\" || d.low_food === true;\n    let alertText = low ? \"CẦN NẠP THÊM THỨC ĂN\" : \"Chưa có cảnh báo mức thức ăn thấp\";\n\n    // Trả về 3 ngõ: [Dashboard Text, Dashboard Cảnh Báo, Telegram ACK]\n    return [{ payload: deviceText }, { payload: alertText }, teleAck];\n} catch (err) {\n    return null;\n}",
