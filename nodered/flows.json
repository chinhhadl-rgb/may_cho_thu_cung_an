    {
        "id": "fn_rule1_rate_limit",
        "type": "function",
        "z": "tab_petfeeder_arch",
        "name": "Rule 1: Chống spam 60s + Tạo lệnh MQTT",
        "func": "const MIN_GAP = 60000; // 60 giây\nlet lastFeed = context.get('lastFeedTime') || 0;\nlet now = Date.now();\n\nlet source = msg.source || msg.topic || \"dashboard_button\";\nlet reqId = source + \"-\" + now;\nconst CHAT_ID = \"8518694966\";\n\n// 1. NẾU CHƯA ĐỦ 60 GIÂY -> CHẶN VÀ BÁO TỪ CHỐI VỀ TELEGRAM\nif (lastFeed > 0 && (now - lastFeed < MIN_GAP)) {\n    let waitSec = Math.ceil((MIN_GAP - (now - lastFeed)) / 1000);\n    \n    let mqttMsg = null;\n    let sqlMsg = {\n        topic: `INSERT INTO feeding_logs (request_id, source, status, note) VALUES ('${reqId}', '${source}', 'REJECTED', 'Vi pham MIN_GAP 60s (con ${waitSec}s)');`\n    };\n    let teleMsg = {\n        headers: { \"Content-Type\": \"application/json\" },\n        payload: {\n            chat_id: CHAT_ID,\n            text: `🚫 TỪ CHỐI CHO ĂN: Chưa đủ 60 giây! Vui lòng chờ thêm ${waitSec} giây nữa.\\n(Nguồn: ${source})`\n        }\n    };\n    let uiMsg = {\n        payload: `BỊ CHẶN (Chờ ${waitSec}s) - Chống ăn quá liều`\n    };\n    let logMsg = {\n        payload: {\n            event: \"REJECT_FEED\",\n            reason: \"MIN_GAP_60S_VIOLATION\",\n            wait_seconds: waitSec,\n            source: source,\n            time: new Date().toLocaleString('vi-VN')\n        }\n    };\n\n    return [mqttMsg, sqlMsg, teleMsg, uiMsg, logMsg];\n}\n\n// 2. NẾU HỢP LỆ (>= 60 GIÂY) -> CHO ĂN VÀ BÁO THÀNH CÔNG VỀ TELEGRAM\ncontext.set('lastFeedTime', now);\n\nlet commandObj = {\n    command: \"FEED_NOW\",\n    request_id: reqId,\n    source: source\n};\n\nlet mqttMsg = {\n    topic: \"petfeeder/control\",\n    payload: JSON.stringify(commandObj)\n};\nlet sqlMsg = {\n    topic: `INSERT INTO feeding_logs (request_id, source, status, note) VALUES ('${reqId}', '${source}', 'SUCCESS', 'Da gui lenh xa hat thanh cong');`\n};\nlet teleMsg = {\n    headers: { \"Content-Type\": \"application/json\" },\n    payload: {\n        chat_id: CHAT_ID,\n        text: `✅ ĐÃ CHO ĂN: Lệnh xả hạt đã được kích hoạt thành công!\\n- Nguồn: ${source}\\n- Mã lệnh: ${reqId}`\n    }\n};\nlet uiMsg = {\n    payload: `ONLINE - Đã gửi lệnh cho ăn (${source})`\n};\nlet logMsg = {\n    payload: {\n        event: \"ALLOW_FEED\",\n        source: source,\n        request_id: reqId,\n        time: new Date().toLocaleString('vi-VN')\n    }\n};\n\nreturn [mqttMsg, sqlMsg, teleMsg, uiMsg, logMsg];",
