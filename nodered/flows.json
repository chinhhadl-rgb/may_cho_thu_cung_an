    {
        "id": "fn_parse_sensor",
        "type": "function",
        "z": "tab_petfeeder_arch",
        "name": "Parse JSON + tách dữ liệu dashboard",
        "func": "let d = msg.payload;\ntry {\n    if (Buffer.isBuffer(d)) d = d.toString('utf8');\n    if (typeof d === 'string') d = JSON.parse(d);\n    if (!d || typeof d !== 'object') return null;\n    const level = Number(d.level_pct);\n    if (!Number.isFinite(level)) return null;\n    const feeds = (d.feeds_today !== undefined) ? d.feeds_today : '--';\n    const maxFeeds = (d.max_feeds_per_day !== undefined) ? d.max_feeds_per_day : '--';\n    const rssi = (d.wifi_rssi !== undefined) ? d.wifi_rssi : '--';\n    const sensorText = d.sensor_ok === false ? 'Lỗi cảm biến' : 'Cảm biến đang hoạt động';\n    return [\n        { payload: Math.max(0, Math.min(100, level)) },\n        { payload: Math.max(0, Math.min(100, level)), topic: 'Mức thức ăn' },\n        { payload: String(feeds) + ' / ' + String(maxFeeds) },\n        { payload: sensorText },\n        { payload: String(rssi) + ' dBm' }\n    ];\n} catch (err) {\n    return null;\n}",
        "outputs": 5,
        "x": 750,
        "y": 200,
        "wires": [
            [
                "ui_gauge_level"
            ],
            [
                "ui_chart_level"
            ],
            [
                "ui_text_feeds"
            ],
            [
                "ui_text_sensor"
            ],
            [
                "ui_text_rssi"
            ]
        ]
    },
