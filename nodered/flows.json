        "z": "tab_petfeeder_arch",
        "name": "Bắt nút bấm & Lệnh Telegram",
        "func": "const p = msg.payload;\nif (!p) return null;\n\n// 1. Bắt sự kiện khi bấm nút Inline Keyboard trên Telegram (chấp nhận cả 2 mã)\nif (p.type === 'callback_query') {\n    if (p.content === 'FEED_NOW' || p.content === 'FEED_FROM_TELEGRAM') {\n        return {\n            payload: 'FEED_NOW',\n            source: 'telegram_inline_button'\n        };\n    }\n}\n\n// 2. Bắt lệnh gõ tay /feed trong khung chat Telegram\nif (p.type === 'message' && typeof p.content === 'string') {\n    if (p.content.trim().toLowerCase() === '/feed') {\n        return {\n            payload: 'FEED_NOW',\n            source: 'telegram_command'\n        };\n    }\n}\n\nreturn null;",
