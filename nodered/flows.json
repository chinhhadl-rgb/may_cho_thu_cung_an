    {
        "id": "fn_prep_sensor_sql",
        "type": "function",
        "z": "tab_petfeeder_arch",
        "name": "Chuẩn bị SQL: sensor_logs",
        "func": "let d = msg.payload;\ntry {\n    if (Buffer.isBuffer(d)) d = d.toString('utf8');\n    if (typeof d === 'string') d = JSON.parse(d);\n    \n    const level = Number(d.level_pct) || 0;\n    const feeds = Number(d.feeds_today) || 0;\n    const rssi = Number(d.wifi_rssi) || -70;\n    const sensor_ok = d.sensor_ok === false ? 0 : 1;\n    \n    msg.topic = `INSERT INTO sensor_logs (level_pct, feeds_today, wifi_rssi, sensor_ok) VALUES (${level}, ${feeds}, ${rssi}, ${sensor_ok});`;\n    return msg;\n} catch(e) {\n    return null;\n}",
        "outputs": 1,
        "x": 730,
        "y": 260,
        "wires": [
            [
                "mysql_node_exec"
            ]
        ]
    },
    {
        "id": "fn_rule2_low_food",
        "type": "function",
        "z": "tab_petfeeder_arch",
        "name": "Rule 2: Kiểm tra hạt < 20% & Gửi Telegram",
        "func": "let d = msg.payload;\n\nconst BOT_TOKEN = \"8877893305:AAH2Fypw0ryfngPg69ShYL7whhVTy0ewQQ8\";\nconst CHAT_ID = \"8518694966\";\nconst TELE_URL = `https://api.telegram.org/bot${BOT_TOKEN}/sendMessage`;\n\ntry {\n    if (Buffer.isBuffer(d)) d = d.toString('utf8');\n    if (typeof d === 'string') d = JSON.parse(d);\n    \n    // Nếu bấm từ nút Inject \"Test thử cảnh báo (< 20%)\" mà không phải object, tự gán level = 15%\n    let level = (d && typeof d === 'object' && d.level_pct !== undefined) ? Number(d.level_pct) : 15;\n    let forceTest = (d && d.force_test === true) || (typeof msg.payload !== 'object');\n\n    let isAlerted = context.get('lowFoodAlerted') || false;\n\n    if (level < 20) {\n        if (!isAlerted || forceTest) {\n            context.set('lowFoodAlerted', true);\n\n            // Ngõ 1: Gửi cảnh báo kèm nút bấm Inline Keyboard sang Telegram API\n            let telePayload = {\n                method: \"POST\",\n                url: TELE_URL,\n                headers: { \"Content-Type\": \"application/json\" },\n                payload: {\n                    chat_id: CHAT_ID,\n                    text: `⚠️ CẢNH BÁO KHẨN CẤP: Phễu thức ăn chỉ còn ${level}% (< 20%). Vui lòng nạp thêm hoặc bấm nút bên dưới để xả hạt khẩn cấp!`,\n                    reply_markup: {\n                        inline_keyboard: [\n                            [\n                                {\n                                    text: \"🍖 Cho ăn ngay\",\n                                    callback_data: \"FEED_FROM_TELEGRAM\"\n                                }\n                            ]\n                        ]\n                    }\n                }\n            };\n\n            // Ngõ 2: Ghi Event Logger\n            let logMsg = {\n                payload: {\n                    event: \"LOW_FOOD_ALERT\",\n                    level_pct: level,\n                    message: \"Đã gửi cảnh báo cạn hạt kèm nút bấm Telegram (< 20%)\",\n                    time: new Date().toLocaleString('vi-VN')\n                }\n            };\n\n            return [telePayload, logMsg];\n        }\n    } else if (level >= 25) {\n        context.set('lowFoodAlerted', false);\n    }\n} catch (e) {\n    node.warn(\"Lỗi xử lý Rule 2: \" + e.message);\n    return null;\n}\n\nreturn null;",
